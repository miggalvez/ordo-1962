{
  "name": "ordo-1962",
  "version": "0.0.0",
  "private": true,
  "description": "The 1962 Roman calendar (1960 rubrics) for any year, nation, institute and church.",
  "license": "MIT",
  "author": "Miguel Galvez",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/generate-data.mjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "convert": "python3 -I scripts/convert_missalemeum.py",
    "pretest": "npm run build",
    "snapshot": "npm run build && node scripts/snapshot.mjs",
    "test": "node --test \"test/**/*.test.mjs\" \"test/**/*.test.cjs\"",
    "test:convert": "python3 -I scripts/test_convert_missalemeum.py"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
